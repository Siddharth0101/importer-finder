# Copy this file to .env and fill in what you have.

# Groq Cloud key (https://console.groq.com/keys). The agent uses it to turn the
# product name into an HS code. Without it a small built-in list is used.
GROQ_API_KEY=

# Model for the agent.
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Shipment-level customs data (importer -> supplier, date, quantity, price).
# Free account with 1,000 API credits: https://www.billofladingdata.com
BOLD_API_KEY=
# Credits: 15 per importer + 1 per shipment. Defaults: 5 importers x 5 shipments = about 100 credits a search.
BOLD_IMPORTERS_PER_PAGE=5
BOLD_SHIPMENTS_PER_IMPORTER=5

API_PORT=3001
