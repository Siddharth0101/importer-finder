{
  "name": "importer-finder",
  "version": "0.2.0",
  "description": "Search a product and a country, get importers, prices by origin and shipment history.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.7.0",
    "@netlify/blobs": "^11.1.7",
    "express": "^5.3.0",
    "langchain": "^1.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.6"
  }
}
